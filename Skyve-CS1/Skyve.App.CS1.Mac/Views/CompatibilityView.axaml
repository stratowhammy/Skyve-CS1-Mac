<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Skyve.App.CS1.Mac.ViewModels"
             x:Class="Skyve.App.CS1.Mac.Views.CompatibilityView"
             x:DataType="vm:CompatibilityViewModel">

    <Grid RowDefinitions="Auto,*" Margin="24">
        <!-- Summary Header -->
        <Border Grid.Row="0" Background="#21252B" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="#282C34" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="COMPATIBILITY REPORT" FontSize="11" FontWeight="Bold" Foreground="#E5C07B" LetterSpacing="1" />
                    <TextBlock Text="Mod &amp; Package Health Diagnostics" FontSize="20" FontWeight="SemiBold" Foreground="#E5E5E5" />
                    <TextBlock Text="Real-time conflict detection, broken mod reporting, and replacement suggestions." FontSize="13" Foreground="#7F848E" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="24,0" VerticalAlignment="Center">
                    <Border Background="#282C34" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Critical:" Foreground="#7F848E" />
                            <TextBlock Text="{Binding CriticalCount}" FontWeight="Bold" Foreground="#E06C75" />
                        </StackPanel>
                    </Border>
                    <Border Background="#282C34" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Warnings:" Foreground="#7F848E" />
                            <TextBlock Text="{Binding WarningCount}" FontWeight="Bold" Foreground="#E5C07B" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" Content="Re-Scan Compatibility" Click="OnRefreshClick" Padding="12,8" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Issues List -->
        <Border Grid.Row="1" Background="#21252B" CornerRadius="8" Padding="12" BorderBrush="#282C34" BorderThickness="1">
            <ListBox ItemsSource="{Binding ReportItems}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CompatibilityItemViewModel">
                        <Border Padding="14" Margin="0,4" Background="#282C34" CornerRadius="6">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Severity Badge -->
                                <Border Grid.Column="0" CornerRadius="4" Padding="8,4" Margin="0,0,14,0" VerticalAlignment="Center"
                                        Background="{Binding SeverityColor}">
                                    <TextBlock Text="{Binding SeverityLabel}" FontSize="11" FontWeight="Bold" Foreground="#1E1E1E" />
                                </Border>

                                <!-- Package & Description -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding PackageName}" FontSize="15" FontWeight="SemiBold" Foreground="#E5E5E5" />
                                        <TextBlock Text="{Binding StatusType, StringFormat='({0})'}" FontSize="12" Foreground="#61AFEF" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" FontSize="13" Foreground="#ABB2BF" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Workshop Button -->
                                <Button Grid.Column="2" Content="Workshop" Click="OnWorkshopClick" Tag="{Binding}" 
                                        Padding="10,6" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
