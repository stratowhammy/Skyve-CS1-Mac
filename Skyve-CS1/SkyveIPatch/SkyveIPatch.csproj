<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Version.props" />
	<Import Project="../../Skyve/Config.props" />
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <Deterministic>false</Deterministic>
    <LangVersion>latest</LangVersion>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>$(DefineConstants);IPATCH</DefineConstants>
    <PathMap>$(MSBuildProjectDirectory)/=$(ProjectName)/</PathMap>
    <UserProfile Condition="'$(UserProfile)' == ''">$(HOME)</UserProfile>
    <SteamPath Condition="Exists('$(UserProfile)/Library/Application Support/Steam')">$(UserProfile)/Library/Application Support/Steam</SteamPath>
    <SteamPath Condition="'$(SteamPath)' == '' and Exists('$(ProgramFiles)/Steam')">$(ProgramFiles)/Steam</SteamPath>
    <SteamPath Condition="'$(SteamPath)' == ''">$(Registry:HKEY_CURRENT_USER\Software\Valve\Steam@SteamPath)</SteamPath>
    <CSPath>$(SteamPath)/steamapps/common/Cities_Skylines</CSPath>
    <ManagedDLLPath Condition="Exists('$(CSPath)/Cities.app/Contents/Resources/Data/Managed')">$(CSPath)/Cities.app/Contents/Resources/Data/Managed</ManagedDLLPath>
    <ManagedDLLPath Condition="'$(ManagedDLLPath)' == '' and Exists('../dependencies')">../dependencies</ManagedDLLPath>
    <ManagedDLLPath Condition="'$(ManagedDLLPath)' == ''">$(CSPath)/Cities_Data/Managed</ManagedDLLPath>
    <AssemblySearchPaths>
      $(AssemblySearchPaths);
      $(ManagedDLLPath);
      $(CitiesSkylinesBinaries);
      ../libs/;
      $(SteamPath)/steamapps/workshop/content/255710/2041457644/;
      $(SteamPath)/steamapps/workshop/content/255710/2041457644/PatchLoader/;
    </AssemblySearchPaths>
    <Configurations>Debug;Release;Stable</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.10.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Mono.Unofficial.pdb2mdb" Version="4.2.3.4" />
    <PackageReference Include="TaskParallelLibrary" Version="1.0.2856">
      <PrivateAssets>System.Threading.dll</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SkyveInjections\SkyveInjections.csproj">
      <Aliases>Injections</Aliases>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ColossalManaged" />
    <Reference Include="ICities" />
    <Reference Include="System.Configuration" />
    <Reference Include="UnityEngine" />
    <Reference Include="UnityEngine.UI" />
    <Reference Include="Patch.API" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Remove="Settings\**" />
    <EmbeddedResource Remove="Settings\**" />
    <None Remove="Settings\**" />
    <Compile Include="..\SkyveMod\Shared\SkyveConfig.cs" Link="Shared\SkyveConfig.cs" />
    <Compile Include="..\SkyveMod\Shared\SharedUtil.cs" Link="Shared\SharedUtil.cs" />
  </ItemGroup>
  
  <Target Name="DeployToModDirectory" AfterTargets="Build">
    <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
      <Output TaskParameter="Assemblies" ItemName="Targets" />
    </GetAssemblyIdentity>
    <ItemGroup>
      <AuxiliaryFiles Include="$(TargetDir)Mono.Cecil.dll;$(TargetDir)System.Threading.dll" />
      <VersionNumber Include="@(Targets->'%(Version)')" />
    </ItemGroup>
    <PropertyGroup>
      <DeployDir Condition="'$(DeployDir)'=='' and Exists('$(UserProfile)/Library/Application Support')">$(UserProfile)/Library/Application Support/Colossal Order/Cities_Skylines/Addons/Mods/Skyve/</DeployDir>
      <DeployDir Condition="'$(DeployDir)'==''">$(LOCALAPPDATA)/Colossal Order/Cities_Skylines/Addons/Mods/$(SolutionName)/</DeployDir>
      <DeployTargetPath>$(DeployDir)Skyve.ipatch</DeployTargetPath>
      <Now>$([System.DateTime]::Now.ToString("HH:mm:ss"))</Now>
      <pdb2mdb>$(PkgMono_Unofficial_pdb2mdb)/tools/pdb2mdb.exe</pdb2mdb>
    </PropertyGroup>

    <Delete Files="$(TargetPath).mdb" />
    <Exec Command="&quot;$(pdb2mdb)&quot; &quot;$(TargetPath)&quot;" Condition="'$(OS)' == 'Windows_NT' and Exists('$(pdb2mdb)')" />
    <Copy SourceFiles="$(TargetPath).mdb" DestinationFiles="$(DeployTargetPath).mdb" Condition="Exists('$(TargetPath).mdb')" />

    <Copy SourceFiles="@(AuxiliaryFiles)" DestinationFolder="$(DeployDir)" />
    <Delete Files="$(DeployTargetPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(DeployTargetPath)" />
    <Message Importance="high" Text="AssemblyVersion=@(VersionNumber) time=$(Now)" />
  </Target>
</Project>


